# Public read API used by Server Components. Never expose these values with NEXT_PUBLIC_.
# Production API exposed by the K-SPORT VPS. Keep the /api/public prefix.
KSPORT_PUBLIC_API_URL=https://admin.luuquancoder.id.vn/api/public
KSPORT_PUBLIC_API_TOKEN=

# Admin API used for authenticated license management. Production should point
# to the recovered VPS, for example https://admin.luuquancoder.id.vn.
KSPORT_ADMIN_API_URL=

# Identity service for web login and admin permissions.
KSPORT_AUTH_URL=

# Google Identity Services client ID used by the Google sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=371569491012-d7qfkghaooven40n6kqbfh1gmvtqs558.apps.googleusercontent.com

# Contact delivery requires a mail provider or an internal API endpoint.
CONTACT_TO_EMAIL=lienhe@k-sport.net
CONTACT_API_URL=
CONTACT_API_TOKEN=

# Secret used to sign web session cookies (HMAC-SHA256). Set a strong random string in production.
AUTH_SECRET=

# Secret used only to sign the temporary, httpOnly license-management session.
# The six-digit passcode itself is created once in the admin UI and is stored
# as a bcrypt hash in PostgreSQL on the license server.
LICENSE_MANAGER_GATE_SECRET=
